{
  "name": "@tangle-network/playproof",
  "version": "0.5.0",
  "description": "Turn games into verifiable, cost-aware benchmarks for any agent.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/playproof.git"
  },
  "homepage": "https://github.com/tangle-network/playproof#readme",
  "bugs": {
    "url": "https://github.com/tangle-network/playproof/issues"
  },
  "keywords": [
    "agents",
    "benchmarks",
    "games",
    "evaluation",
    "verification",
    "replay",
    "steam",
    "xbox",
    "emulators",
    "openai",
    "claude-code"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "import": "./dist/drivers/index.js"
    },
    "./drivers/cli": {
      "types": "./dist/drivers/cli.d.ts",
      "import": "./dist/drivers/cli.js"
    },
    "./drivers/openai-compatible": {
      "types": "./dist/drivers/openai-compatible.d.ts",
      "import": "./dist/drivers/openai-compatible.js"
    },
    "./adapters/worker-rpc": {
      "types": "./dist/adapters/worker-rpc.d.ts",
      "import": "./dist/adapters/worker-rpc.js"
    },
    "./adapters/native-2048": {
      "types": "./dist/adapters/native-2048.d.ts",
      "import": "./dist/adapters/native-2048.js"
    },
    "./adapters/native-desktop": {
      "types": "./dist/adapters/native-desktop.d.ts",
      "import": "./dist/adapters/native-desktop.js"
    },
    "./adapters/pyboy-rpc": {
      "types": "./dist/adapters/pyboy-rpc.d.ts",
      "import": "./dist/adapters/pyboy-rpc.js"
    },
    "./adapters/pyboy-generic": {
      "types": "./dist/adapters/pyboy-generic.d.ts",
      "import": "./dist/adapters/pyboy-generic.js"
    },
    "./adapters/pyboy-tetris": {
      "types": "./dist/adapters/pyboy-tetris.d.ts",
      "import": "./dist/adapters/pyboy-tetris.js"
    },
    "./adapters/ale-rpc": {
      "types": "./dist/adapters/ale-rpc.d.ts",
      "import": "./dist/adapters/ale-rpc.js"
    },
    "./adapters/ale": {
      "types": "./dist/adapters/ale.d.ts",
      "import": "./dist/adapters/ale.js"
    },
    "./adapters/gym-rpc": {
      "types": "./dist/adapters/gym-rpc.d.ts",
      "import": "./dist/adapters/gym-rpc.js"
    },
    "./adapters/gymnasium": {
      "types": "./dist/adapters/gymnasium.d.ts",
      "import": "./dist/adapters/gymnasium.js"
    },
    "./adapters/retro-rpc": {
      "types": "./dist/adapters/retro-rpc.d.ts",
      "import": "./dist/adapters/retro-rpc.js"
    },
    "./adapters/stable-retro": {
      "types": "./dist/adapters/stable-retro.d.ts",
      "import": "./dist/adapters/stable-retro.js"
    },
    "./adapters/retroarch-rpc": {
      "types": "./dist/adapters/retroarch-rpc.d.ts",
      "import": "./dist/adapters/retroarch-rpc.js"
    },
    "./adapters/retroarch": {
      "types": "./dist/adapters/retroarch.d.ts",
      "import": "./dist/adapters/retroarch.js"
    },
    "./platforms/steam": {
      "types": "./dist/platforms/steam.d.ts",
      "import": "./dist/platforms/steam.js"
    },
    "./platforms/xbox": {
      "types": "./dist/platforms/xbox.d.ts",
      "import": "./dist/platforms/xbox.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsup && node scripts/copy-assets.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx playproof.test.mts && tsx calibration.test.mts && tsx episode.test.mts && tsx observation.test.mts && tsx platform.test.mts && tsx desktop-platforms.test.mts && tsx drivers.test.mts && tsx campaign.test.mts",
    "test:pyboy": "tsx pyboy-tetris.test.mts",
    "test:retro": "tsx stable-retro.test.mts",
    "test:ale": "tsx ale.test.mts",
    "test:gym": "tsx gymnasium.test.mts",
    "test:retroarch": "tsx retroarch.test.mts",
    "test:pyboy-libbet": "tsx pyboy-libbet.test.mts",
    "verify:package": "node scripts/verify-package.mjs",
    "ci": "pnpm check:boundary && pnpm typecheck && pnpm test && pnpm build && pnpm verify:package",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm run ci"
  },
  "devDependencies": {
    "@tangle-network/agent-runtime": "0.142.3",
    "@types/node": "^25.9.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
